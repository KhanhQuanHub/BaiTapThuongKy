{
  // ================================================================
  // figlog - DỮ LIỆU MẪU CHO json-server
  // Mỗi key cấp 1 = 1 bảng = 1 đường dẫn API:
  //   "users" -> GET/POST http://IP:3000/users
  // Mỗi phần tử BẮT BUỘC có "id" (số, duy nhất trong bảng).
  // Khóa ngoại đặt tên <tênSốÍt>Id (userId, exerciseId...) để dùng
  // được _expand / _embed.
  // ================================================================

  // ---------- 1. TÀI KHOẢN (Chức năng 1) ----------
  // Đăng nhập: POST /login {email, password} -> trả về token.
  // CẢNH BÁO: password chữ thường CHỈ để học/demo. App thật phải băm.
  // role : "user" (người dùng thường) | "admin" (quản trị)
  //        Quyền hạn từng vai trò được kiểm soát trong file auth.js.
  "users": [
    { "id": 1, "email": "quan@figlog.vn",  "password": "123456",   "fullName": "Nguyễn Khánh Quân", "role": "user",  "createdAt": "2026-10-01T08:00:00.000Z" },
    { "id": 2, "email": "ha@figlog.vn",    "password": "123456",   "fullName": "Thanh Hà",           "role": "user",  "createdAt": "2026-10-03T09:30:00.000Z" },
    { "id": 3, "email": "admin@figlog.vn", "password": "admin123", "fullName": "Quản trị viên",      "role": "admin", "createdAt": "2026-09-30T07:00:00.000Z" }
  ],

  // ---------- 2. HỒ SƠ SỨC KHỎE (Chức năng 1) ----------
  // userId            : khóa ngoại -> users.id
  // gender            : "male" | "female" (quyết định hệ số sải chân)
  // bmi               : weightKg / (heightCm/100)^2, làm tròn 1 số lẻ
  // bmiGroup          : "thin" <18.5 | "normal" 18.5-24.9 | "overweight" 25-29.9 | "obese" >=30
  // healthCondition   : "none" | "cardio" | "joint" | "respiratory"
  //                     -> đầu vào của Cây quyết định (Safety Gate)
  // sessionsPerWeek   : số buổi tập cam kết mỗi tuần (2..6)
  // calibratedStrideM : sải chân đã hiệu chuẩn (m), null = chưa hiệu chuẩn
  "profiles": [
    { "id": 1, "userId": 1, "gender": "male", "heightCm": 175, "weightKg": 60, "bmi": 19.6, "bmiGroup": "normal", "healthCondition": "none", "sessionsPerWeek": 4, "calibratedStrideM": null },
    { "id": 2, "userId": 2, "gender": "female", "heightCm": 162, "weightKg": 52, "bmi": 19.8, "bmiGroup": "normal", "healthCondition": "joint", "sessionsPerWeek": 3, "calibratedStrideM": null }
  ],

  // ---------- 3. LỊCH SỬ CÂN NẶNG ----------
  // Mỗi lần cập nhật cân nặng thì POST thêm 1 dòng (không sửa dòng cũ)
  // để vẽ biểu đồ biến thiên. date: "YYYY-MM-DD".
  "weightHistory": [
    { "id": 1, "userId": 1, "weightKg": 58, "date": "2026-09-15" },
    { "id": 2, "userId": 1, "weightKg": 59, "date": "2026-10-01" },
    { "id": 3, "userId": 1, "weightKg": 60, "date": "2026-10-20" },
    { "id": 4, "userId": 2, "weightKg": 53, "date": "2026-10-03" },
    { "id": 5, "userId": 2, "weightKg": 52, "date": "2026-10-24" }
  ],

  // ---------- 4. DANH MỤC 8 MỤC TIÊU (Chức năng 2) ----------
  // Bảng tham chiếu cố định, app chỉ đọc (GET).
  "goals": [
    { "id": 1, "code": "weight_loss", "name": "Giảm cân / Đốt mỡ" },
    { "id": 2, "code": "weight_gain", "name": "Tăng cân lành mạnh" },
    { "id": 3, "code": "maintenance", "name": "Cân bằng / Duy trì thể trạng" },
    { "id": 4, "code": "muscle_gain", "name": "Tăng cơ & phát triển sức mạnh" },
    { "id": 5, "code": "cardio", "name": "Tăng sức bền Cardio" },
    { "id": 6, "code": "flexibility", "name": "Cải thiện độ linh hoạt & dẻo dai" },
    { "id": 7, "code": "general", "name": "Tăng cường sức khỏe tổng thể" },
    { "id": 8, "code": "stress_relief", "name": "Kiểm soát căng thẳng / Thiền vận động" }
  ],

  // ---------- 5. MỤC TIÊU CỦA NGƯỜI D NG ----------
  // targetWeightKg: cân nặng đích | deadlineWeeks: thời hạn (tuần)
  // minMinutesPerWeek: cam kết tối thiểu (phút/tuần)
  "userGoals": [
    { "id": 1, "userId": 1, "goalId": 2, "targetWeightKg": 65, "deadlineWeeks": 12, "minMinutesPerWeek": 150 },
    { "id": 2, "userId": 2, "goalId": 6, "targetWeightKg": 52, "deadlineWeeks": 8, "minMinutesPerWeek": 120 }
  ],

  // ---------- 6. THƯ VIỆN BÀI TẬP (Chức năng 3) ----------
  // equipment : "none" | "mat" | "rope" | "machine" | "dumbbell"
  // met       : hệ số MET dùng tính calo
  // impact    : "low" | "high" (high = nhảy bật, hại khớp)
  // sets/reps : số hiệp / số lần (reps = 0 nếu tính theo thời gian)
  // durationSec: giây mỗi hiệp (0 nếu tính theo số lần)
  // youtubeId : phần sau "v=" trong link YouTube.
  // Cây quyết định: bệnh khớp -> impact=low ; tim mạch -> met<=5.0
  "exercises": [
    { "id": 1, "name": "Hít đất (Push-up)", "muscleGroup": "Ngực, tay sau", "equipment": "none", "met": 4.5, "impact": "low", "sets": 3, "reps": 12, "durationSec": 0, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 2, "name": "Squat tự trọng", "muscleGroup": "Chân, mông", "equipment": "none", "met": 5.0, "impact": "low", "sets": 3, "reps": 15, "durationSec": 0, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 3, "name": "Jumping Jacks", "muscleGroup": "Toàn thân", "equipment": "none", "met": 8.0, "impact": "high", "sets": 3, "reps": 0, "durationSec": 60, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 4, "name": "Plank", "muscleGroup": "Bụng, core", "equipment": "mat", "met": 4.0, "impact": "low", "sets": 3, "reps": 0, "durationSec": 45, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 5, "name": "Yoga chào mặt trời", "muscleGroup": "Toàn thân", "equipment": "mat", "met": 3.0, "impact": "low", "sets": 1, "reps": 10, "durationSec": 0, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 6, "name": "Nhảy dây", "muscleGroup": "Toàn thân", "equipment": "rope", "met": 10.0, "impact": "high", "sets": 4, "reps": 0, "durationSec": 120, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 7, "name": "Đạp xe tĩnh", "muscleGroup": "Chân", "equipment": "machine", "met": 5.0, "impact": "low", "sets": 1, "reps": 0, "durationSec": 1200, "youtubeId": "YOUTUBE_VIDEO_ID" },
    { "id": 8, "name": "Chạy bộ tốc độ vừa (8km/h)", "muscleGroup": "Cardio", "equipment": "none", "met": 8.0, "impact": "high", "sets": 1, "reps": 0, "durationSec": 1800, "youtubeId": "YOUTUBE_VIDEO_ID" }
  ],

  // ---------- 7. LỊCH TẬP (Chức năng 3 + 4) ----------
  // userId, exerciseId : khóa ngoại
  // date, time         : "YYYY-MM-DD", "HH:mm"
  // status             : "planned" | "done" | "missed"
  // durationMin        : phút tập thực tế (0 nếu chưa tập)
  // caloriesBurned     : met * weightKg * (durationMin/60)
  // Thống kê: GET /workouts?userId=1&status=done&date_gte=...&date_lte=...
  "workouts": [
    { "id": 1, "userId": 1, "exerciseId": 1, "date": "2026-10-26", "time": "18:00", "status": "done", "durationMin": 30, "caloriesBurned": 135, "note": "Tập tại phòng trọ" },
    { "id": 2, "userId": 1, "exerciseId": 2, "date": "2026-10-27", "time": "18:00", "status": "done", "durationMin": 40, "caloriesBurned": 200, "note": "" },
    { "id": 3, "userId": 1, "exerciseId": 4, "date": "2026-10-28", "time": "18:30", "status": "missed", "durationMin": 0, "caloriesBurned": 0, "note": "Bận đồ án" },
    { "id": 4, "userId": 1, "exerciseId": 1, "date": "2026-10-30", "time": "18:00", "status": "planned", "durationMin": 0, "caloriesBurned": 0, "note": "" },
    { "id": 5, "userId": 2, "exerciseId": 5, "date": "2026-10-27", "time": "20:00", "status": "done", "durationMin": 45, "caloriesBurned": 117, "note": "Giảm đau lưng" },
    { "id": 6, "userId": 2, "exerciseId": 7, "date": "2026-10-29", "time": "19:00", "status": "planned", "durationMin": 0, "caloriesBurned": 0, "note": "" }
  ],

  // ---------- 8. BUỔI CHẠY BỘ (Chức năng 5 - Pedometer Offline-First) ----------
  // clientId     : mã định danh do app sinh để chống ghi trùng (idempotent)
  // date         : ngày theo GIỜ ĐỊA PHƯƠNG (YYYY-MM-DD), không phải UTC
  // source       : "pedometer" | "manual" | "gps"
  // steps        : tổng số bước đếm được
  // strideM      : sải chân (m) = heightCm*0.415/100 (nam) | *0.413/100 (nữ) hoặc hiệu chuẩn
  // strideSource : "formula" | "calibrated"
  // distanceKm   : làm tròn 2 chữ số từ steps * strideM / 1000
  // durationSec  : thời gian di chuyển thực tế (giây), không tính lúc tạm dừng
  // pausedSec    : tổng thời gian tạm dừng (giây)
  // avgSpeedKmh  : distanceKm / (durationSec / 3600)
  // paceSecPerKm : durationSec / distanceKm (giây/km)
  // cadenceSpm   : steps / (durationSec / 60) (bước/phút)
  // met          : nội suy tuyến tính theo avgSpeedKmh (4->3.0, 8->8.0, 10->11.5, 12->12.5)
  // calories     : Math.round(met * weightKg * (durationSec / 3600))
  "runs": [
