{
  "expo": {
    "name": "FitLog",
    "slug": "FitLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "FitLog cần truy cập cảm biến bước chân (Pedometer) để đo quãng đường và tính lượng calo khi bạn chạy bộ.",
        "NSLocalNetworkUsageDescription": "FitLog cần kết nối tới máy chủ json-server trong mạng nội bộ (LAN) để đồng bộ dữ liệu buổi chạy khi thử nghiệm.",
        "NSLocationWhenInUseUsageDescription": "FitLog cần vị trí của bạn để ghi lại lộ trình chạy bộ."
      }
    },
    "android": {
      "package": "com.quan.fitlog",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "KHÓA_CỦA_BẠN"
        }
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "FitLog cần truy cập cảm biến bước chân (Pedometer) để đo quãng đường và tính lượng calo khi bạn chạy bộ."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitLog cần vị trí của bạn để ghi lại lộ trình chạy bộ."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5d9f8a16-0b19-4774-a821-7372230e7cf3"
      }
    },
    "owner": "kquan11"
  }
}
